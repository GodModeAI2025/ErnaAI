{
  "name": "erna-ai",
  "version": "1.0.0",
  "private": true,
  "description": "Elektronische Recherche- und Notiz-Anwendung für Steuerkanzleien",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.tsx",
    "start": "node dist/index.js",
    "build": "tsc",
    "seed": "tsx src/data/seed.ts",
    "test": "vitest",
    "lint": "eslint src/**/*.ts src/**/*.tsx"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.123.0",
    "date-fns": "4.4.0",
    "dotenv": "17.4.2",
    "gray-matter": "4.0.3",
    "ink": "7.1.1",
    "ink-select-input": "6.2.0",
    "ink-text-input": "6.0.0",
    "react": "19.2.8",
    "uuid": "14.0.2"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@typescript-eslint/eslint-plugin": "8.69.0",
    "@typescript-eslint/parser": "8.69.0",
    "eslint": "10.10.0",
    "ink-testing-library": "4.0.0",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  }
}
